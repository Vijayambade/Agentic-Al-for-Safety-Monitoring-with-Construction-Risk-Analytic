# ============================================================
# Construction Intelligent Hub — Environment Variables
# Copy this file to .env and fill in the real values
# ============================================================

# ---- Application ----
ENVIRONMENT=development
APP_NAME=Construction Intelligent Hub
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-random-64-character-string

# ---- Database ----
DATABASE_URL=sqlite:///./data/construction_hub.db
MONGO_URI=mongodb://localhost:27017/construction_hub
REDIS_URL=redis://localhost:6379/0

# ---- JWT Authentication ----
JWT_SECRET=change-this-jwt-secret-to-random-32-chars-minimum
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
JWT_REMEMBER_ME_EXPIRE_DAYS=30

# ---- AI Services ----
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=local
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Embedding Model ----
EMBEDDING_MODEL=keyword

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# ---- Weather API (OpenWeatherMap) ----
WEATHER_API_KEY=your-openweathermap-api-key-here
WEATHER_API_URL=https://api.openweathermap.org/data/2.5

# ---- Email (SMTP) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password-here
SMTP_FROM_NAME=Construction Intelligent Hub
SMTP_TLS=true

# ---- SMS Gateway ----
SMS_GATEWAY_KEY=your-sms-gateway-api-key-here
SMS_GATEWAY_URL=https://api.smsgateway.com/send

# ---- Encryption ----
ENCRYPTION_KEY=your-32-byte-fernet-encryption-key-here

# ---- File Storage ----
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_SIZE_MB=50
FAISS_INDEX_DIR=./data/faiss_indexes
YOLO_WEIGHTS_PATH=./ai/models/yolo_weights/yolov8n.pt

# ---- OCR ----
TESSERACT_CMD=/usr/bin/tesseract

# ---- Frontend ----
BACKEND_URL=http://localhost:8000
STREAMLIT_SERVER_PORT=8501

# ---- Logging ----
LOG_LEVEL=INFO
LOG_DIR=./logs

# ---- Rate Limiting ----
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOCKOUT_MINUTES=30

# ---- Cache ----
CACHE_TTL_SECONDS=3600
WEATHER_CACHE_TTL_SECONDS=1800
ANALYTICS_CACHE_TTL_SECONDS=60
